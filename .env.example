# Public (browser) values — safe to expose, protected by RLS
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR-ANON-KEY
VITE_SUPABASE_PROJECT_ID=YOUR-PROJECT-ID

# Edge-function SECRETS — set these in Supabase (Project → Edge Functions → Secrets), never in the repo:
#   ADMIN_PASSCODE   (>= 12 chars, long random string)
#   RESEND_API_KEY
#   OWNER_EMAIL      (where contact notifications go)
#   LOVABLE_API_KEY
#   LOVABLE_AI_MODEL (optional; defaults to existing openai/gpt-6-astra)
#   CONTACT_FROM_EMAIL (a sender on your verified Resend domain)
# Supabase injects SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY on the server.
# Apply ALL supabase/migrations before deploying functions; quotas fail closed.
# Contact messages are stored before success; email notification is optional.
# No confirmation email is sent to unverified visitor addresses.
# Production proxy must append/overwrite X-Forwarded-For; see SECURITY.md.
